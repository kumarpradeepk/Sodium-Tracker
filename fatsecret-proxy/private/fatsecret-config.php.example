<?php
declare(strict_types=1);

/*
 * Copy this file to `fatsecret-config.php` in a directory OUTSIDE the web
 * root. Do not add the copied file to Git or upload it under public_html.
 *
 * BigRock cPanel deployment layout:
 *   /home/CPANEL_USER/public_html/pinch-api/      <- contents of public/
 *   /home/CPANEL_USER/pinch-api-private/          <- this copied config file
 *   /home/CPANEL_USER/pinch-api-private/cache/    <- chmod 700
 */
return [
    'fatsecret_client_id' => 'REPLACE_WITH_OAUTH2_CLIENT_ID',
    'fatsecret_client_secret' => 'REPLACE_WITH_OAUTH2_CLIENT_SECRET',
    'cache_dir' => '/home/CPANEL_USER/pinch-api-private/cache',
    // Per source IP, per minute. Mobile requests are deliberately restricted
    // to only search and food-detail routes by the proxy implementation.
    'rate_limit_per_minute' => 60,
];
