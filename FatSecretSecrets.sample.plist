<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  FatSecret Platform API credentials (platform.fatsecret.com).

	  Setup:
	  1. Copy this file into  Sodium Tracker/Resources/
	  2. Rename it to        FatSecretSecrets.plist
	  3. Replace the two placeholder values below.

	  The real file is git-ignored so your secret never lands in the repo.
	-->
	<key>ClientID</key>
	<string>YOUR-CLIENT-ID</string>
	<key>ClientSecret</key>
	<string>YOUR-CLIENT-SECRET</string>
</dict>
</plist>
